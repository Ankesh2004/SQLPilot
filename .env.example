# ============================================
# SQLPilot Environment Configuration
# Copy this to .env and fill in your values
# ============================================

# --- LLM Provider ---
# Gemini Flash (primary, free tier)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq (optional, for future use / self-consistency)
# GROQ_API_KEY=your_groq_api_key_here

# which provider to use: "gemini" or "groq"
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash

# --- Database ---
# for demo mode, we use SQLite (no config needed, it's just a file)
DB_TYPE=sqlite
SQLITE_DB_PATH=data/demo.db

# for production, switch to postgres
# DB_TYPE=postgres
# POSTGRES_URL=postgresql://sqlpilot_readonly:password@localhost:5432/sqlpilot

# --- RAG ---
# ChromaDB stores its data here (persistent mode)
CHROMA_PERSIST_DIR=data/chroma

# embedding model (runs locally via sentence-transformers)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Observability (Langfuse) ---
# sign up at https://cloud.langfuse.com (free tier)
# LANGFUSE_HOST must match your project's region (shown in the Langfuse UI
# under Settings -- e.g. https://us.cloud.langfuse.com or https://jp.cloud.langfuse.com).
# Using the wrong region host causes silent 401 Unauthorized errors.
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_HOST=https://cloud.langfuse.com

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Misc ---
LOG_LEVEL=INFO
MAX_RETRIES=3
STATEMENT_TIMEOUT_MS=30000
MAX_RESULT_ROWS=1000
